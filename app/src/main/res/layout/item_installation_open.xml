<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInstallation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border_soft"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <!-- Root SIN padding para que la barra quede pegada -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ✅ Barra de estado lateral -->
            <View
                android:id="@+id/viewStatusBar"
                android:layout_width="10dp"
                android:layout_height="0dp"
                android:background="@color/inst_paid_bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- ✅ Contenido con padding -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/viewStatusBar"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ===== Columna izquierda (Orden/Serie/Placa: valor) ===== -->

                <!-- Orden: valor -->
                <LinearLayout
                    android:id="@+id/rowOrden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/colRight"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvOrdenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orden:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvOrdenValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0001"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Serie: valor -->
                <LinearLayout
                    android:id="@+id/rowSerie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowOrden">

                    <TextView
                        android:id="@+id/tvSerieLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Serie:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvSerieValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ABC123"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Placa: valor -->
                <LinearLayout
                    android:id="@+id/rowPlaca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowSerie">

                    <TextView
                        android:id="@+id/tvPlacaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Placa:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvPlacaValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="XYZ987"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMarcaModelo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Marca, Modelo"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowPlaca" />

                <!-- ===== Columna derecha (pagado/fecha/iconos) ===== -->
                <LinearLayout
                    android:id="@+id/colRight"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvPagadoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagado:"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvPagadoValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sí"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAlignment="viewStart" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp"
                        android:textAlignment="viewEnd" />

                    <!-- Botones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="10dp">

                        <ImageButton
                            android:id="@+id/btnCheck"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Marcar/desmarcar"
                            app:srcCompat="@drawable/check_box_marked"
                            app:tint="@color/success" />

                        <ImageButton
                            android:id="@+id/btnEdit"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editar"
                            app:srcCompat="@drawable/ic_edit"
                            app:tint="@color/warning" />

                        <ImageButton
                            android:id="@+id/btnDelete"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Eliminar"
                            app:srcCompat="@drawable/ic_delete"
                            app:tint="@color/error" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== GRID META: Condición / Bodega ===== -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridMeta2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:columnCount="2"
                    app:useDefaultMargins="true"
                    app:layout_constraintTop_toBottomOf="@id/tvMarcaModelo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- CONDICIÓN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_columnWeight="1">

                        <TextView
                            android:text="Condición:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvCondicionValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- BODEGA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_columnWeight="1">

                        <TextView
                            android:text="Bodega:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvBodegaValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                </androidx.gridlayout.widget.GridLayout>

                <!-- ===== GRID META: Sede / Inc ===== -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:columnCount="2"
                    app:useDefaultMargins="true"
                    app:layout_constraintTop_toBottomOf="@id/gridMeta2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- SEDE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_columnWeight="2">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sede:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvSedeValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- INCREMENTO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_columnWeight="1.2">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inc:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvIncrementValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.gridlayout.widget.GridLayout>

                <!-- Título sección accesorios -->
                <TextView
                    android:id="@+id/tvAccesoriosTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Accesorios:"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/gridMeta"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- CABECERA LISTA -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:columnCount="4"
                    app:useDefaultMargins="true"
                    android:paddingVertical="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvAccesoriosTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="#"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:alpha="0.85"
                        android:gravity="center"
                        app:layout_columnWeight="0.4" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:alpha="0.85"
                        android:gravity="center"
                        app:layout_columnWeight="1.6" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Precio base"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:alpha="0.85"
                        android:gravity="center"
                        app:layout_columnWeight="1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pagado"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:alpha="0.85"
                        android:gravity="center"
                        app:layout_columnWeight="1" />
                </androidx.gridlayout.widget.GridLayout>

                <!-- Lista de accesorios -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAccessories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_accessory_row_open"
                    app:layout_constraintTop_toBottomOf="@id/gridHeader"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Footer totales + comentario -->
                <LinearLayout
                    android:id="@+id/rowTotals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/rvAccessories"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="P:"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/tvTotalPagadoValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NP:"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/tvTotalNoPagadoValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:alpha="0.85"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Comentario: revisar instalación, falta tornillo..." />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
