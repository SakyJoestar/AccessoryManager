<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInstallation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border_soft"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <!-- Root SIN padding para que la barra quede pegada -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ✅ Barra de estado lateral -->
            <View
                android:id="@+id/viewStatusBar"
                android:layout_width="10dp"
                android:layout_height="0dp"
                android:background="@color/inst_paid_bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- ✅ Contenido con padding (tu layout original adentro) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/viewStatusBar"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ===== Columna izquierda ===== -->

                <LinearLayout
                    android:id="@+id/rowOrden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/colRight"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvOrdenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orden:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvOrdenValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSerie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowOrden">

                    <TextView
                        android:id="@+id/tvSerieLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Serie:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvSerieValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPlaca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowSerie">

                    <TextView
                        android:id="@+id/tvPlacaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Placa:"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvPlacaValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMarcaModelo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@id/rowOrden"
                    app:layout_constraintEnd_toEndOf="@id/rowOrden"
                    app:layout_constraintTop_toBottomOf="@id/rowPlaca" />

                <!-- ===== Columna derecha ===== -->

                <LinearLayout
                    android:id="@+id/colRight"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:text="Pagado:"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content" />

                        <TextView
                            android:id="@+id/tvPagadoValue"
                            android:layout_marginStart="6dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp"
                        android:textAlignment="viewEnd" />

                    <!-- Botones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="10dp">

                        <ImageButton
                            android:id="@+id/btnCheck"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Marcar/desmarcar"
                            app:srcCompat="@drawable/check_box_marked"
                            app:tint="@color/success" />

                        <ImageButton
                            android:id="@+id/btnEdit"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editar"
                            app:srcCompat="@drawable/ic_edit"
                            app:tint="@color/warning" />

                        <ImageButton
                            android:id="@+id/btnDelete"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Eliminar"
                            app:srcCompat="@drawable/ic_delete"
                            app:tint="@color/error" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Totales ===== -->
                <LinearLayout
                    android:id="@+id/rowTotals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMarcaModelo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T:"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="P:"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/tvTotalPagadoValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NP:"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/tvTotalNoPagadoValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- ===== DETALLE EXPANDIBLE ===== -->
                <LinearLayout
                    android:id="@+id/layoutDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/rowTotals"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
