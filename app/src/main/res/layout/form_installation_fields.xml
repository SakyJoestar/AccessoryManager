<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Guías para 2 columnas -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.0" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineMid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="1.0" />

        <!-- ========== FILA 1: Orden | Serie ========== -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOrder"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Orden"
            app:layout_constraintStart_toStartOf="@id/guidelineStart"
            app:layout_constraintEnd_toStartOf="@id/guidelineMid"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOrder"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="7" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSerie"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Serie"
            app:layout_constraintStart_toStartOf="@id/guidelineMid"
            app:layout_constraintEnd_toStartOf="@id/guidelineEnd"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSerie"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="8"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========== FILA 2: Placa | Bodega ========== -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlate"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Placa"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/tilOrder"
            app:layout_constraintStart_toStartOf="@id/guidelineStart"
            app:layout_constraintEnd_toStartOf="@id/guidelineMid">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlate"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWarehouse"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Bodega"
            android:layout_marginTop="14dp"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toBottomOf="@id/tilSerie"
            app:layout_constraintStart_toStartOf="@id/guidelineMid"
            app:layout_constraintEnd_toStartOf="@id/guidelineEnd">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWarehouse"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========== FILA 3: Condición | Fecha ========== -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCondition"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Condición"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            app:endIconMode="dropdown_menu"
            app:layout_constraintTop_toBottomOf="@id/tilPlate"
            app:layout_constraintStart_toStartOf="@id/guidelineStart"
            app:layout_constraintEnd_toStartOf="@id/guidelineMid">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actCondition"
                style="@style/AppInputDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Fecha"
            android:layout_marginTop="14dp"
            android:layout_marginStart="10dp"
            app:endIconDrawable="@drawable/ic_calendar"
            app:layout_constraintTop_toBottomOf="@id/tilWarehouse"
            app:layout_constraintStart_toStartOf="@id/guidelineMid"
            app:layout_constraintEnd_toStartOf="@id/guidelineEnd">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========== FILA: Sede (full) + botón ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rowHeadquarter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tilCondition"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHeadquarter"
                style="@style/AppInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Sede"
                android:layout_marginEnd="8dp"
                app:endIconMode="dropdown_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnAddHeadquarter"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actHeadquarter"
                    style="@style/AppInputDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddHeadquarter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Crear sede"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@android:color/holo_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_24"
                app:iconPadding="0dp"
                app:iconTint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIncrement"
            style="@style/AppInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Incremento"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/rowHeadquarter"
            app:layout_constraintStart_toStartOf="@id/guidelineStart"
            app:layout_constraintEnd_toStartOf="@id/guidelineMid"
            android:clickable="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIncrement"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ========== FILA 5: Vehículo (+) ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rowVehicle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tilIncrement"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVehicle"
                style="@style/AppInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Vehículo"
                app:endIconMode="dropdown_menu"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnAddVehicle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actVehicle"
                    style="@style/AppInputDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddVehicle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Crear vehiculo"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@android:color/holo_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_24"
                app:iconPadding="0dp"
                app:iconTint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========== LISTA DE ACCESORIOS (Header +) ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAccessoriesHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rowVehicle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvAccessoriesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Accesorios"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnAddAccessoryInline"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAccessoryInline"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Crear accesorio"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@android:color/holo_green_dark"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_24"
                app:iconPadding="0dp"
                app:iconTint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========== LISTA DE ACCESORIOS ========== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccessories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAccessoriesHeader" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccessory"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_add_24"
            android:text="@string/agregar_accesorio"
            app:iconPadding="6dp"
            android:layout_marginVertical="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvAccessories" />

        <!-- ========== FOTOS ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPhotosHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnAddAccessory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvPhotosTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Fotos"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPhotosCounter"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvPhotosCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/5"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAddPhoto"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPhotosHeader"

            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivAddPhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Agregar foto"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvAddPhotoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Agregar fotos"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAddPhotoSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:text="Toca para tomar una foto o elegir desde galería"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/layoutPhotosCarousel"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardAddPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpPhotos"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddMorePhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Agregar otra foto"
                app:backgroundTint="@color/primary"
                app:srcCompat="@drawable/ic_add_24"
                app:tint="@android:color/white"
                app:maxImageSize="24dp"
                app:fabSize="mini" />

        </FrameLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabPhotosIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:background="@android:color/transparent"
            app:tabIndicator="@null"
            app:tabIndicatorHeight="0dp"
            app:tabInlineLabel="true"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="6dp"
            app:tabPaddingEnd="6dp"
            app:tabRippleColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/layoutPhotosCarousel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ========== Pago ========== -->
        <TextView
            android:id="@+id/tvPaymentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pagado"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabPhotosIndicator" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tgPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaid"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Si"
                android:clickable="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotPaid"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:clickable="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPartiallyPaid"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parcial"
                android:clickable="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTotalWorked"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/total_instalaci_n"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tgPaymentStatus">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalWorked"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:clickable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaid"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Total Pagado"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilTotalWorked">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPaid"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUnpaid"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Total no Pagado"
            android:layout_marginTop="12dp"
            android:clickable="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilPaid">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUnpaid"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilComment"
            style="@style/AppInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Comentario"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilUnpaid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComment"
                style="@style/AppInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:gravity="bottom|start"
                android:minLines="4"
                android:maxLines="6"
                android:paddingTop="12dp"
                android:paddingBottom="20dp"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilComment" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
